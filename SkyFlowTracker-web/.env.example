# Copy to .env.local for your own development targets.
# DEV_* is server-side only. VITE_* values are public in the generated browser code.
DEV_HOST=127.0.0.1
DEV_API_TARGET=http://localhost:8080
DEV_WS_TARGET=ws://localhost:8080
DEV_MEDIA_TARGET=http://localhost
VITE_MEDIA_BASE_PATH=/SkyFlowTracker
