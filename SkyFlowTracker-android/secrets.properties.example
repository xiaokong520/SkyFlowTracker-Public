# Copy to secrets.properties. SDK keys are client identifiers, not server secrets.
# Restrict keys by package name and signing certificate in the provider console.
MSDK_API_KEY=
AMAP_API_KEY=
# Android emulator -> host. Physical devices need their own reachable address.
API_BASE_URL=http://10.0.2.2:8080/api/v1/
WEB_BASE_URL=http://10.0.2.2:5173
